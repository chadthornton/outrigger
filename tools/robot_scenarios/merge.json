  "routes": [
    {"from": {"robot": "a", "cable": 0}, "to": {"robot": "b", "cable": 1}},
    {"from": {"robot": "b", "cable": 0}, "to": {"robot": "b", "cable": 1}}
  ],
  "checks": {"loss_max": 0, "extra_max": 0, "order": true, "latency_ms_max": 5, "jitter_ms_max": 1, "stuck_notes_max": 0}
