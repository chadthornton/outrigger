// A second sample screen, for the list and button widgets: a synth's
// patches, with buttons under them.
{
  "screen": "patch_list",
  "root": {
    "type": "page", "style": "screen", "width": "100%", "height": "100%",
    "layout": { "flex": "column", "gap": "$space.sm" },
    "children": [
      { "type": "label", "text": "{synth.name} patches", "style": { "font": "$type.title" } },
      { "type": "list", "id": "patches", "items": "{patches}", "width": "100%", "grow": 1 },
      { "type": "page", "width": "100%",
        "layout": { "flex": "row", "main": "end", "gap": "$space.sm" },
        "children": [
          { "type": "button", "id": "prev", "text": "Back" },
          { "type": "button", "id": "load", "text": "Load", "style": "primary" }
        ] }
    ]
  }
}
