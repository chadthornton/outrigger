+#if defined(CONFIG_IDF_TARGET_ESP32P4)
+#include "esp_cache.h"
+#endif
+
 void
 os_icache_flush(void *start, size_t len)
-{}
+{
+#if defined(CONFIG_IDF_TARGET_ESP32P4)
+    /* Outrigger P4 spike patch: AOT code is written through the L1 data
+       cache; write it back, then drop any instruction-cache lines for it,
+       before the CPU runs it. (Upstream leaves this empty.) */
+    uintptr_t a = (uintptr_t)start & ~(uintptr_t)127;
+    uintptr_t e = ((uintptr_t)start + len + 127) & ~(uintptr_t)127;
+    esp_cache_msync((void *)a, e - a,
+                    ESP_CACHE_MSYNC_FLAG_DIR_C2M | ESP_CACHE_MSYNC_FLAG_TYPE_DATA
+                        | ESP_CACHE_MSYNC_FLAG_UNALIGNED);
+    esp_cache_msync((void *)a, e - a,
+                    ESP_CACHE_MSYNC_FLAG_DIR_M2C | ESP_CACHE_MSYNC_FLAG_TYPE_INST);
+    __asm__ volatile("fence.i" ::: "memory");
+#else
+    (void)start;
+    (void)len;
+#endif
+}
 
