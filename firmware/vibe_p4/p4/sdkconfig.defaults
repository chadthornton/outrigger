# Big-P4 (Waveshare ESP32-P4-WIFI6-Touch-LCD-3.5), silicon rev v3.2: the same base as A2's p4_emu
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_SPEED_200M=y
# the native Vibes' .bss (two 300 KB framebuffers among it) goes to PSRAM, like the .wasm's linear memory
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Console on UART0 at 115200: Big-P4's Mac cable is on UART-C (CH343P, /dev/cu.usbmodem5CF70432541)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# the bench task runs flat out on core 1 during a sweep
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_FREERTOS_HZ=1000
# WAMR's AOT code runs from heap memory with MALLOC_CAP_EXEC: needs the IRAM/DRAM PMP split off
CONFIG_ESP_SYSTEM_PMP_IDRAM_SPLIT=n
# WAMR: what the SDK's .wasm needs (shared memory + atomics, bulk memory, reference types), nothing else
CONFIG_WAMR_BUILD_RELEASE=y
CONFIG_WAMR_ENABLE_AOT=y
CONFIG_WAMR_ENABLE_INTERP=y
CONFIG_WAMR_INTERP_LOADER_NORMAL=y
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=n
CONFIG_WAMR_ENABLE_LIBC_WASI=n
CONFIG_WAMR_ENABLE_LIB_PTHREAD=n
CONFIG_WAMR_ENABLE_SHARED_MEMORY=y
CONFIG_WAMR_ENABLE_REF_TYPES=y
